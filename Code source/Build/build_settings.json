{
  "toolchain": "Zig 0.15.2, Windows x86_64",
  "native_flags": [
    "-target",
    "x86_64-windows-gnu",
    "-O0",
    "-fno-sanitize=all",
    "-ffreestanding",
    "-fno-builtin",
    "-fno-stack-protector",
    "-mno-stack-arg-probe",
    "-ffunction-sections",
    "-fdata-sections"
  ],
  "features": [
    "-DLID_CHECKS_DIAGNOSTIC_ENABLED=1",
    "-DLID_REFLECTION_READ_SCOPE_ENABLED=1",
    "-DLID_FAST_MASTER_SCAN_ENABLED=1",
    "-DLID_EVENT_PROFILE_ENABLED=1",
    "-DLID_CHARACTER_DELIVERY_ENABLED=1",
    "-DLID_CHARACTER_DIAGNOSTIC_ONLY=0",
    "-DLID_CHARACTER_ENTRY_DELIVERY_READY=1",
    "-DLID_BLUEPRINT_DELIVERY_ENABLED=1",
    "-DLID_DECAL_DELIVERY_ENABLED=1",
    "-DLID_NATIVE_RELOAD_ENABLED=1",
    "-DLID_SHOP_FEATURE_ENABLED=1",
    "-DLID_CHECKS_ROTATION_ENABLED=1",
    "-DLID_CHECKS_DELIVERY_ENABLED=1",
    "-DLID_RELOAD_LOAD_TRACE_ENABLED=1",
    "-DLID_RELOAD_DECODE_TRACE_ENABLED=1",
    "-DLID_MASTER_SCAN_GUARD_ENABLED=1",
    "-DLID_MATERIAL_CAPABILITY_ENABLED=1",
    "-DLID_KILL_COIN_PICKUP_ENABLED=0",
    "-DLID_KILL_COIN_HUB_ENABLED=1",
    "-DLID_KILL_COIN_DIAGNOSTIC_ENABLED=1",
    "-DLID_KILL_COIN_DELIVERY_ENABLED=1",
    "-DLID_MATERIAL_PICKUP_OPTIMIZED_ENABLED=1",
    "-DLID_CHARACTER_PROFILE_ENABLED=1",
    "-DLID_NOTIFICATIONS_ENABLED=1",
    "-DLID_CHARACTER_READ_OPTIMIZED_ENABLED=1"
  ],
  "fast_flags": [
    "-target",
    "x86_64-windows-gnu",
    "-fno-sanitize=all",
    "-fno-strict-aliasing",
    "-ffreestanding",
    "-fno-builtin",
    "-fno-stack-protector",
    "-mno-stack-arg-probe",
    "-O2"
  ],
  "guard_flags": [
    "-target",
    "x86_64-windows-gnu",
    "-O0",
    "-fms-extensions",
    "-fexceptions",
    "-fasync-exceptions",
    "-fno-sanitize=all",
    "-ffreestanding",
    "-fno-builtin",
    "-fno-stack-protector",
    "-mno-stack-arg-probe",
    "-ffunction-sections",
    "-fdata-sections"
  ]
}
